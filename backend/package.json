    "express-session": "^1.19.0",
    "httpntlm": "^1.8.13",
    "mssql": "^12.7.0",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.44.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
